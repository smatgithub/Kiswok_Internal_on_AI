# SQL Server — aligns with Internal-API + Internal-Site
# Internal-API style:
DB_SERVER=your-sql-host
DB_USER=your-user
DB_PASS=your-password
DB_NAME=icsoft
# Read replica (optional alias of DB_SERVER)
# INDBIP=your-sql-read-host
# Write primary for INSERT/UPDATE (e.g. 10.1.3.198)
DB_WRITE_SERVER=
DB_REPORT_SERVER=

# Internal-Site aliases (optional; used as fallback)
# DBUSER=your-user
# DBPASS=your-password
# ICSOFTDB=icsoft
# INDB=indb
# false = live ERP queries
USE_MOCK_ERP=false

API_PORT=4010
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4010/api

# Auth — reuse V2 Internal-API (same EmpLoginDetails / JWT)
# Dev/test default; prod: https://internalv2.kiswok.com/api
INTERNAL_API_URL=https://testv2.kiswok.com/api
# Copy JWT_SECRET from Internal-API .env (required to guard V3 Nest routes)
JWT_SECRET=
# Optional overrides (defaults match Internal-API)
# JWT_REFRESH_SECRET=
# ACCESS_TOKEN_EXPIRY=15m
# REFRESH_TOKEN_EXPIRY=7d

# Local Internal-API uses self-signed HTTPS on :4001
# INTERNAL_API_URL=https://localhost:4001/api
# INTERNAL_API_TLS_INSECURE=true
