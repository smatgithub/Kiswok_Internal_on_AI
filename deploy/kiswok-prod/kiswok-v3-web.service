[Unit]
Description=Kiswok Internal V3 Next.js UI
After=network.target kiswok-v3-api.service

[Service]
Type=simple
User=kiswok
WorkingDirectory=/home/kiswok/Workspace/Kiswok_Internal_on_AI/apps/web
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3010
Environment=API_PROXY_TARGET=http://127.0.0.1:4010
ExecStart=/home/kiswok/Workspace/Kiswok_Internal_on_AI/deploy/kiswok-prod/start-web.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
